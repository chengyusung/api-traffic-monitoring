# 複製為 .env 後至少修改 JWT_SECRET_KEY 與所有密碼。
# 這裡的值只供本機 demo，不要用於任何對外環境。

# ---- Database (MariaDB 11.7) ----
MARIADB_ROOT_PASSWORD=change-me-root
MARIADB_DATABASE=traffic
MARIADB_USER=traffic
MARIADB_PASSWORD=change-me
DB_HOST=db
DB_PORT=3306
DATABASE_URL=mysql+asyncmy://traffic:change-me@db:3306/traffic
# traffic_test 由 db/init/01-create-test-db.sh 在 volume 首次初始化時建立；已有 volume 要 docker compose down -v 重建
TEST_DATABASE_URL=mysql+asyncmy://traffic:change-me@db:3306/traffic_test
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800

# ---- Auth ----
# 產生方式：openssl rand -hex 32。值含 change-me 時 api 拒絕啟動。
JWT_SECRET_KEY=change-me-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---- Bootstrap admin（啟動時若尚無任何 ADMIN 則建立，之後不再動）----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin1234!

# ---- Demo data（true：建立 demo user / viewer 與範例資料；production 設 false）----
SEED_DEMO_DATA=true
DEMO_USER_EMAIL=user@example.com
DEMO_USER_PASSWORD=User1234!
DEMO_VIEWER_EMAIL=viewer@example.com
DEMO_VIEWER_PASSWORD=Viewer1234!

# ---- Simulator / Ingestion（見 docs/decisions/001-ingestion-buffer.md）----
SIMULATOR_ENABLED=true
SIMULATOR_SEED=42
SIMULATOR_INTERVAL_SECONDS=1
BUFFER_CAPACITY=1000
BATCH_MAX_SIZE=100
FLUSH_INTERVAL_SECONDS=5
RETRY_INITIAL_BACKOFF_SECONDS=1
RETRY_MAX_BACKOFF_SECONDS=30
SHUTDOWN_FLUSH_TIMEOUT_SECONDS=10
# 每次 writer 寫入嘗試的上限（也是 asyncmy read_timeout）；逾時視為暫時錯誤，退避後重試
COMMIT_TIMEOUT_SECONDS=10
THRESHOLD_RELOAD_SECONDS=5

# ---- WebSocket（見 docs/decisions/003-realtime-delivery.md）----
WS_MAX_CONNECTIONS=100
WS_PER_CONNECTION_QUEUE=100

# ---- Import / Export ----
IMPORT_MAX_ROWS=10000
IMPORT_MAX_BYTES=5242880
EXPORT_MAX_ROWS=50000

# ---- API ----
API_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8501

# ---- Frontend ----
FRONTEND_PORT=8501
API_BASE_URL=http://api:8000/api/v1
API_WS_URL=ws://api:8000/api/v1/ws/traffic
